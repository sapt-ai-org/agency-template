# Your Sapt API key with reflecting scope.
# Generate at app.sapt.ai -> Account Settings -> API Keys.
SAPT_API_KEY=

# Public PKCE OAuth client ID. Create at app.sapt.ai -> any project ->
# Project Settings -> OAuth Clients. Type: "public". Use
# https://<your-worker>.workers.dev/auth/callback as the redirect URL.
# There is no client secret — PKCE is used instead.
SAPT_OAUTH_CLIENT_ID=
